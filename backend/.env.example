DATABASE_URL=postgresql+psycopg://sorbonne:sorbonne@localhost:5433/sorbonne
TEST_DATABASE_URL=postgresql+psycopg://sorbonne:sorbonne@localhost:5433/sorbonne_test
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional: enables Google Books as a server-side fallback for book-reference lookup.
GOOGLE_BOOKS_API_KEY=

# Teacher document workflow. Leave all of these unset to keep the integration disabled.
# Store the service-account JSON only in local/hosted encrypted environment configuration.
GOOGLE_DOCUMENTS_OAUTH_CLIENT_ID=
GOOGLE_DOCUMENTS_SERVICE_ACCOUNT_JSON=
GOOGLE_DOCUMENTS_RESPONSE_SHEET_ID=
GOOGLE_DOCUMENTS_RESPONSE_SHEET_RANGE=Form Responses 1!A:ZZ
GOOGLE_DOCUMENTS_RESPONSE_EMAIL_HEADER=Email address
GOOGLE_DOCUMENTS_RESPONSE_TIMESTAMP_HEADER=Timestamp
GOOGLE_DOCUMENTS_DRIVE_ROOT_FOLDER_ID=
# Comma-separated named staff email addresses. These people receive Google Drive reader access.
GOOGLE_DOCUMENTS_ACCESS_EMAILS=
# 100 MiB maximum uncompressed file total for a generated ZIP.
GOOGLE_DOCUMENTS_MAX_ZIP_BYTES=104857600
